# Copy to server/.env for local development.

# --- Server ---
PORT=8787
DATABASE_PATH=./data/videovault.db
PUBLIC_ORIGIN=http://localhost:5173

# --- Cloudflare R2 (S3 API) ---
# Dashboard -> R2 -> Manage R2 API tokens -> Object Read & Write, scoped to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-vault
# Optional: point at MinIO for fully-offline local dev, e.g. http://localhost:9000
# S3_ENDPOINT=

# --- Auth ---
# Seeded only on first boot when no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Random 32+ chars: openssl rand -hex 32
SESSION_SECRET=

# --- Tuning ---
PART_SIZE_BYTES=52428800
VIEW_URL_TTL_SECONDS=3600
PART_URL_TTL_SECONDS=3600
SESSION_TTL_DAYS=30

# --- Grid thumbnails ---
# Photos get a small WebP derivative generated on first view and cached in R2,
# so grid tiles fetch ~25 KB instead of the multi-megabyte original.
# Each job decodes a full-resolution photo in memory: raise concurrency only on
# a box with RAM to spare.
THUMBNAILS_ENABLED=true
THUMB_MAX_EDGE=512
THUMB_QUALITY=72
THUMB_CONCURRENCY=2
# Originals larger than this are left alone and served as-is (40 MB).
THUMB_MAX_SOURCE_BYTES=41943040
