# Copy to server/.env for local development.

# --- Server ---
PORT=8787
DATABASE_PATH=./data/videovault.db
PUBLIC_ORIGIN=http://localhost:5173

# --- Cloudflare R2 (S3 API) ---
# Dashboard -> R2 -> Manage R2 API tokens -> Object Read & Write, scoped to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-vault
# Optional: point at MinIO for fully-offline local dev, e.g. http://localhost:9000
# S3_ENDPOINT=

# --- Auth ---
# Seeded only on first boot when no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Random 32+ chars: openssl rand -hex 32
SESSION_SECRET=

# --- Tuning ---
PART_SIZE_BYTES=52428800
VIEW_URL_TTL_SECONDS=3600
PART_URL_TTL_SECONDS=3600
SESSION_TTL_DAYS=30
